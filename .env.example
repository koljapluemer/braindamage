CS2CAP_API_KEY=
# Set to "true" once a Starter+ (or higher) CS2Cap subscription is active.
CS2CAP_PREMIUM_TIER=

# https://csfloat.com/profile -- "developer" tab. Free, no tier. Only needed
# for `find_contracts.py --postvalidate-csfloat`.
CSFLOAT_API_KEY=

# https://docs.steamapis.com -- SteamApis dashboard, paid. Only needed for
# `find_tradeup_buys.py`.
STEAMAPIS_KEY=

# EUR->USD conversion rate, hand-maintained -- only needed if your Steam
# account currency is EUR (braindamage/steam_offers_host.py converts to USD
# at write time using this rate). Update it by hand every so often, e.g.
# from https://www.ecb.europa.eu/stats/policy_and_exchange_rates/euro_reference_exchange_rates/html/eurofxref-graph-usd.en.html
EUR_USD_RATE=
