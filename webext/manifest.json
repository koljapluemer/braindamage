{
  "manifest_version": 3,
  "name": "braindamage Steam Offer Fetcher",
  "version": "0.2.0",
  "description": "Docks a collapsible mono-trade price sidebar onto Steam Community Market listing pages and sends what it scrapes to the braindamage native host.",
  "browser_specific_settings": {
    "gecko": {
      "id": "steam-offers@braindamage.local"
    }
  },
  "action": {
    "default_title": "Toggle braindamage sidebar"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://steamcommunity.com/market/listings/*", "*://*.csfloat.com/*"],
      "js": [
        "vendor/vue.runtime.global.prod.js",
        "vendor/chart.umd.min.js",
        "vendor/tailwind.js",
        "sidebar.render.generated.js",
        "float_diagrams.js",
        "sidebar.js"
      ],
      "css": ["sidebar.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["nativeMessaging", "storage"],
  "host_permissions": ["*://steamcommunity.com/market/listings/*", "*://*.csfloat.com/*"]
}
